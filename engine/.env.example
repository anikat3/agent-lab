# Copy to .env and fill in. .env is git-ignored.

# Shared secret. AgentLab sends it as "Authorization: Bearer <key>".
# Must match the EVAL_ENGINE_API_KEY secret configured in the AgentLab app.
# Generate one with: python3.13 -c "import secrets; print(secrets.token_urlsafe(32))"
EVAL_ENGINE_API_KEY=replace-me-with-a-long-random-string

# SQLAlchemy database URL. Defaults to a local SQLite file.
DATABASE_URL=sqlite:///./agentlab_engine.db

# Optional tuning (defaults shown).
# SQLITE_BUSY_TIMEOUT_MS=5000
# WORKER_POLL_INTERVAL_SECONDS=1.0
# WORKER_LEASE_SECONDS=30
# WORKER_SHUTDOWN_GRACE_SECONDS=10
