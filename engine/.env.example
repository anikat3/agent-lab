# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Shared secret. AgentLab sends it as "Authorization: Bearer <key>".
# Must match the EVAL_ENGINE_API_KEY secret configured in the AgentLab app.
# Generate one with: python3.13 -c "import secrets; print(secrets.token_urlsafe(32))"
EVAL_ENGINE_API_KEY=replace-me-with-a-long-random-string

# SQLAlchemy database URL. Defaults to a local SQLite file.
DATABASE_URL=sqlite:///./agentlab_engine.db

# Executor: "langgraph" runs scenarios through the LangGraph workflow (needs a provider key).
# "none" (the default) stores and serves runs but refuses new launches with 503.
EVAL_EXECUTOR=langgraph

# OpenAI credentials for the agent's model. Server-side only.
OPENAI_API_KEY=
# Optional: an OpenAI-compatible endpoint instead of the real API. For development
# without charges, run `python -m tests.fake_openai_server 8799` and use:
# OPENAI_BASE_URL=http://127.0.0.1:8799/v1
# OPENAI_API_KEY=sk-local-test-key-not-a-real-key

# Optional tuning (defaults shown).
# MODEL_TIMEOUT_SECONDS=60        # budget for one model call, retries included
# MODEL_MAX_RETRIES=2             # client retries for 429 / 5xx / connection errors
# SQLITE_BUSY_TIMEOUT_MS=5000
# WORKER_POLL_INTERVAL_SECONDS=1.0
# WORKER_LEASE_SECONDS=30
# WORKER_SHUTDOWN_GRACE_SECONDS=10
